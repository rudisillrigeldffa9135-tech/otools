// Cloudflare Workers 部署配置，详见 README「部署到 Cloudflare Workers」
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "otools",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  // H5 构建产物作为静态资源；只有 /api/*（接口）、/s/*（短链跳转）与 /r/*（快传纯文本）先进入 Worker，其余请求直接命中静态资源
  "assets": {
    "directory": "./dist/build/h5",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/s/*", "/r/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "otools",
      // 执行 `pnpm exec wrangler d1 create otools` 后，把输出的 database_id 填到这里
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "worker/migrations"
    }
  ],
  // 文件快传的存储桶。部署脚本 scripts/cf-prepare.mjs 会自动创建并设置 8 天自动过期的生命周期规则；
  // 账户未开通 R2 时脚本会在 CI 工作区去掉这段绑定，其余功能照常部署
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "otools-files" }
  ],
  // 每 15 分钟清理一次过期的文件（含 R2 对象）、快传、限流记录与会话
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    // 'true' 时开放自助注册（注册的都是普通用户）
    "ALLOW_REGISTER": "false",
    // 免费套餐若登录时出现 CPU 超限（1102），可调低，如 "50000"
    "PBKDF2_ITERATIONS": "100000"
  }
  // 密钥不要写在这里：pnpm exec wrangler secret put VAULT_KEY
}
