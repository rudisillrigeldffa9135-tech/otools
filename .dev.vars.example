# 本地 `pnpm worker:dev` 使用的密钥，复制为 .dev.vars 后修改（.dev.vars 不入库）
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VAULT_KEY=REPLACE_WITH_BASE64_32_BYTES

# 浏览器推送（可选）：VAPID 密钥对，生成方式见 scripts/cf-prepare.mjs 的 generateVapidKeys
# VAPID_PRIVATE_KEY={"kty":"EC","crv":"P-256","x":"...","y":"...","d":"..."}
# VAPID_PUBLIC_KEY=BASE64URL_65_BYTES
